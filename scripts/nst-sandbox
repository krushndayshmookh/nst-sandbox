#!/bin/bash
# nst-sandbox — CLI for managing student sandbox containers on the NST cluster
# Usage: nst-sandbox <command> [args]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="$SCRIPT_DIR/../templates/sandbox-pod.yaml"
IMAGE="${NST_SANDBOX_IMAGE:-registry.nstsdc.org/nst-sandbox:latest}"
BASE_PORT=30000  # SSH NodePort base (30000 + offset)
MAX_STUDENTS=314
DOMAIN="nstsdc.org"
CLUSTER_HOST="nst-n1.nstsdc.org"

# Port allocation: hash student ID to a port in range 30000-30999
get_port() {
    local student_id="$1"
    # Check if namespace exists and has a NodePort already
    local existing_port
    existing_port=$(kubectl get svc sandbox-ssh -n "sandbox-$student_id" -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo "")
    if [[ -n "$existing_port" ]]; then
        echo "$existing_port"
        return
    fi
    # Find next available port
    local used_ports
    used_ports=$(kubectl get svc -A -o jsonpath='{range .items[*]}{.spec.ports[*].nodePort}{"\n"}{end}' 2>/dev/null | sort -n)
    for port in $(seq $BASE_PORT $((BASE_PORT + MAX_STUDENTS + 100))); do
        if ! echo "$used_ports" | grep -q "^${port}$"; then
            echo "$port"
            return
        fi
    done
    echo "ERROR: No available ports" >&2
    exit 1
}

generate_password() {
    # Readable 8-char password
    cat /dev/urandom | tr -dc 'a-hjkmnp-z2-9' | head -c 8
}

cmd_create() {
    local student_id="$1"
    local password="${2:-$(generate_password)}"

    if [[ -z "$student_id" ]]; then
        echo "Usage: nst-sandbox create <student-id> [password]"
        exit 1
    fi

    # Validate student ID (alphanumeric + hyphens, lowercase)
    student_id=$(echo "$student_id" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')

    # Check if already exists
    if kubectl get namespace "sandbox-$student_id" &>/dev/null; then
        echo "❌ Sandbox for '$student_id' already exists. Use 'reset' to recreate."
        exit 1
    fi

    local port
    port=$(get_port "$student_id")

    echo "🚀 Creating sandbox for: $student_id"
    echo "   SSH Port: $port"
    echo "   Web URL:  http://$student_id.$DOMAIN"

    # Generate manifest from template
    local manifest
    manifest=$(sed \
        -e "s|__STUDENT_ID__|$student_id|g" \
        -e "s|__PASSWORD__|$password|g" \
        -e "s|__SSH_PORT__|$port|g" \
        -e "s|__IMAGE__|$IMAGE|g" \
        "$TEMPLATE")

    echo "$manifest" | kubectl apply -f -

    # Wait for pod to be ready
    echo -n "⏳ Waiting for pod..."
    kubectl wait --for=condition=Ready pod/sandbox -n "sandbox-$student_id" --timeout=120s 2>/dev/null && echo " ✅" || echo " ⚠️  Pod not ready yet (may take a minute)"

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🎉 Sandbox ready!"
    echo ""
    echo "  SSH:  ssh $student_id@$CLUSTER_HOST -p $port"
    echo "  Pass: $password"
    echo "  Web:  http://$student_id.$DOMAIN"
    echo ""
    echo "  Edit ~/public/index.html to deploy your site!"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

cmd_delete() {
    local student_id="$1"
    if [[ -z "$student_id" ]]; then
        echo "Usage: nst-sandbox delete <student-id>"
        exit 1
    fi
    student_id=$(echo "$student_id" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')

    echo "🗑️  Deleting sandbox for: $student_id"
    kubectl delete namespace "sandbox-$student_id" --grace-period=10 2>/dev/null && echo "✅ Deleted." || echo "❌ Sandbox not found."
}

cmd_reset() {
    local student_id="$1"
    local password="${2:-$(generate_password)}"
    if [[ -z "$student_id" ]]; then
        echo "Usage: nst-sandbox reset <student-id> [new-password]"
        exit 1
    fi
    student_id=$(echo "$student_id" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')

    echo "🔄 Resetting sandbox for: $student_id"
    kubectl delete namespace "sandbox-$student_id" --grace-period=10 2>/dev/null || true
    sleep 2
    cmd_create "$student_id" "$password"
}

cmd_list() {
    echo "📋 Active sandboxes:"
    echo ""
    printf "%-20s %-8s %-30s %-10s\n" "STUDENT" "PORT" "URL" "STATUS"
    printf "%-20s %-8s %-30s %-10s\n" "-------" "----" "---" "------"

    for ns in $(kubectl get namespaces -l app=nst-sandbox -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do
        local student_id="${ns#sandbox-}"
        local port
        port=$(kubectl get svc sandbox-ssh -n "$ns" -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo "?")
        local status
        status=$(kubectl get pod sandbox -n "$ns" -o jsonpath='{.status.phase}' 2>/dev/null || echo "Unknown")
        printf "%-20s %-8s %-30s %-10s\n" "$student_id" "$port" "http://$student_id.$DOMAIN" "$status"
    done
}

cmd_info() {
    local student_id="$1"
    if [[ -z "$student_id" ]]; then
        echo "Usage: nst-sandbox info <student-id>"
        exit 1
    fi
    student_id=$(echo "$student_id" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')

    if ! kubectl get namespace "sandbox-$student_id" &>/dev/null; then
        echo "❌ No sandbox found for '$student_id'"
        exit 1
    fi

    local port
    port=$(kubectl get svc sandbox-ssh -n "sandbox-$student_id" -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo "?")
    local status
    status=$(kubectl get pod sandbox -n "sandbox-$student_id" -o jsonpath='{.status.phase}' 2>/dev/null || echo "Unknown")
    local cpu mem
    cpu=$(kubectl top pod sandbox -n "sandbox-$student_id" --no-headers 2>/dev/null | awk '{print $2}' || echo "?")
    mem=$(kubectl top pod sandbox -n "sandbox-$student_id" --no-headers 2>/dev/null | awk '{print $3}' || echo "?")

    echo "📦 Sandbox: $student_id"
    echo "   Status:  $status"
    echo "   SSH:     ssh $student_id@$CLUSTER_HOST -p $port"
    echo "   Web:     http://$student_id.$DOMAIN"
    echo "   CPU:     $cpu"
    echo "   Memory:  $mem"
}

cmd_bulk() {
    local csv_file="$1"
    if [[ -z "$csv_file" || ! -f "$csv_file" ]]; then
        echo "Usage: nst-sandbox bulk <students.csv>"
        echo ""
        echo "CSV format: student-id (one per line, or student-id,password)"
        exit 1
    fi

    local count=0
    local creds_file="sandbox-credentials-$(date +%Y%m%d-%H%M%S).txt"

    echo "📋 Bulk provisioning from: $csv_file"
    echo "   Credentials will be saved to: $creds_file"
    echo ""

    echo "# NST Sandbox Credentials — $(date)" > "$creds_file"
    echo "# student-id | password | ssh command | web url" >> "$creds_file"
    echo "" >> "$creds_file"

    while IFS=',' read -r student_id password; do
        student_id=$(echo "$student_id" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')
        [[ -z "$student_id" || "$student_id" == \#* ]] && continue

        password="${password:-$(generate_password)}"
        password=$(echo "$password" | tr -d '[:space:]')

        echo "--- [$((count+1))] $student_id ---"
        cmd_create "$student_id" "$password" 2>&1 | tail -1

        local port
        port=$(kubectl get svc sandbox-ssh -n "sandbox-$student_id" -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo "?")

        echo "$student_id | $password | ssh $student_id@$CLUSTER_HOST -p $port | http://$student_id.$DOMAIN" >> "$creds_file"
        count=$((count + 1))

        # Small delay to avoid hammering the API server
        sleep 1
    done < "$csv_file"

    echo ""
    echo "✅ Provisioned $count sandboxes"
    echo "📄 Credentials saved to: $creds_file"
}

cmd_stop() {
    local student_id="$1"
    if [[ -z "$student_id" ]]; then
        echo "Usage: nst-sandbox stop <student-id>"
        exit 1
    fi
    student_id=$(echo "$student_id" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')
    echo "⏸️  Stopping sandbox: $student_id"
    kubectl delete pod sandbox -n "sandbox-$student_id" 2>/dev/null && echo "✅ Stopped (data preserved in PVC)." || echo "❌ Not found."
}

cmd_start() {
    local student_id="$1"
    if [[ -z "$student_id" ]]; then
        echo "Usage: nst-sandbox start <student-id>"
        exit 1
    fi
    student_id=$(echo "$student_id" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')

    if ! kubectl get namespace "sandbox-$student_id" &>/dev/null; then
        echo "❌ No sandbox namespace for '$student_id'. Use 'create' first."
        exit 1
    fi

    local password="${2:-$(generate_password)}"
    local port
    port=$(get_port "$student_id")

    echo "▶️  Starting sandbox: $student_id"
    # Re-apply just the pod from the template
    sed \
        -e "s|__STUDENT_ID__|$student_id|g" \
        -e "s|__PASSWORD__|$password|g" \
        -e "s|__SSH_PORT__|$port|g" \
        -e "s|__IMAGE__|$IMAGE|g" \
        "$TEMPLATE" | kubectl apply -f - 2>/dev/null

    kubectl wait --for=condition=Ready pod/sandbox -n "sandbox-$student_id" --timeout=120s 2>/dev/null && echo "✅ Running." || echo "⚠️  Starting..."
}

cmd_help() {
    echo "nst-sandbox — Student sandbox manager for NST cluster"
    echo ""
    echo "Usage: nst-sandbox <command> [args]"
    echo ""
    echo "Commands:"
    echo "  create <student-id> [password]   Create a new sandbox"
    echo "  delete <student-id>              Delete sandbox and all data"
    echo "  reset  <student-id> [password]   Recreate sandbox (fresh start)"
    echo "  stop   <student-id>              Stop pod (preserves data)"
    echo "  start  <student-id> [password]   Start a stopped sandbox"
    echo "  list                             List all sandboxes"
    echo "  info   <student-id>              Show sandbox details + usage"
    echo "  bulk   <students.csv>            Bulk provision from CSV"
    echo "  help                             Show this help"
    echo ""
    echo "Environment:"
    echo "  NST_SANDBOX_IMAGE   Container image (default: registry.nstsdc.org/nst-sandbox:latest)"
    echo ""
    echo "Examples:"
    echo "  nst-sandbox create john-doe"
    echo "  nst-sandbox bulk students.csv"
    echo "  nst-sandbox list"
}

# Main dispatch
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    create)  cmd_create "${1:-}" "${2:-}" ;;
    delete)  cmd_delete "${1:-}" ;;
    reset)   cmd_reset "${1:-}" "${2:-}" ;;
    stop)    cmd_stop "${1:-}" ;;
    start)   cmd_start "${1:-}" "${2:-}" ;;
    list)    cmd_list ;;
    info)    cmd_info "${1:-}" ;;
    bulk)    cmd_bulk "${1:-}" ;;
    help|*)  cmd_help ;;
esac
